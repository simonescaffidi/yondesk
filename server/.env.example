PORT=3000
# Dominio canonico (principale). yondesk.net e www.* vengono reindirizzati qui con 301.
SITE_URL=https://yondesk.com
# Alias da reindirizzare 301 al dominio canonico (host, separati da virgola)
REDIRECT_HOSTS=yondesk.net,www.yondesk.net,www.yondesk.com
# Analytics / Search Console (chiedere a Simone gli ID reali)
GA4_ID=
GSC_VERIFICATION=
# WebRTC
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# in alternativa a TURN_USERNAME/TURN_CREDENTIAL: segreto condiviso con il relay (credenziali temporanee)
TURN_SECRET=
GITHUB_REPO=simonescaffidi/yondesk
DATA_DIR=./data
# Email (standard: API Brevo). Mittente verificato su Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=info@simonescaffidi.it
MAIL_FROM_NAME=Yondesk
# Alert email su errori (regola fissa)
ALERT_EMAIL=info@simonescaffidi.it
ALERT_TEST_TOKEN=
# SMTP: SOLO fallback temporaneo se BREVO_API_KEY manca. Da rimuovere dopo il passaggio a Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
